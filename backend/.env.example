# Optional: defaults to backend/data/investigations.sqlite3.
# DATABASE_PATH=./data/investigations.sqlite3

# LIVE Ethereum configuration. All connection settings come from environment variables.
ETHEREUM_PROVIDER=blockscout
ETHEREUM_API_URL=https://eth.blockscout.com/api/v2
# Public instance was validated without a key. For Blockscout PRO use:
# ETHEREUM_API_URL=https://api.blockscout.com/1/api/v2
# ETHEREUM_API_KEY=your_private_bearer_key
ETHEREUM_API_KEY=
ETHEREUM_TIMEOUT_SECONDS=15
# Limits per address / record type / operation, not lifetime history:
ETHEREUM_MAX_PAGES=2
ETHEREUM_MAX_RECORDS=100
# Maximum primary-graph transaction events (up to 3 nodes per event).
ETHEREUM_GRAPH_LIMIT=40
# Maximum normalized events persisted in one case.
ETHEREUM_CASE_LIMIT=1200

# Live OSINT: DDGS uses DuckDuckGo without a key; Brave remains optional.
OSINT_PROVIDER=ddgs
OSINT_API_URL=https://api.search.brave.com/res/v1/web/search
OSINT_API_KEY=
# Optional: explicitly enable Bing public RSS if Brave is unavailable.
# RSS can be irrelevant/incomplete; exact-identifier checks still apply.
OSINT_ALLOW_RSS_FALLBACK=false
# Alternatives: OSINT_PROVIDER=bing_rss or OSINT_PROVIDER=github
# github searches public issues/pull requests only, not the full web.
OSINT_TIMEOUT_SECONDS=10
OSINT_RETRIES=2
OSINT_MAX_RESULTS=5
OSINT_CACHE_SECONDS=3600
OSINT_FETCH_PAGES=true

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
MAX_AUTO_STEPS=5
GEMINI_TIMEOUT_SECONDS=45
GEMINI_RETRIES=1
# Automatically enabled for new LIVE cases when GEMINI_API_KEY is present.
# GEMINI_ENABLED=false explicitly selects deterministic reasoning.


# Solana LIVE collection. Public mainnet needs no key; dedicated URLs stay server-side.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_CLUSTER=mainnet-beta
SOLANA_TIMEOUT_SECONDS=15
SOLANA_RETRIES=1
# Latest signatures per wallet per action, not exhaustive wallet history.
SOLANA_MAX_SIGNATURES=10
SOLANA_CASE_LIMIT=1200
